{
  "name": "warrant",
  "private": true,
  "version": "0.1.0",
  "description": "Effect-first execution layer for payment agents",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "node db/migrate.mjs",
    "db:reset": "node db/migrate.mjs --reset",
    "db:up": "docker compose up -d --wait postgres",
    "keys:generate": "node scripts/generate-keys.mjs",
    "db:test:rls": "node db/rls.test.mjs",
    "demo": "npm run build --workspace @warrant/core --if-present && npm run build --workspace @warrant/api && node apps/api/dist/demo.js",
    "seed": "node apps/api/dist/seed.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
