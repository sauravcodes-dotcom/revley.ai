# Copy to .env for local development. .env is gitignored.

# Port 5433 to avoid colliding with a Postgres already running on 5432.
#
# Two URLs on purpose. The application connects as warrant_app, which is NOT a superuser
# and does NOT have BYPASSRLS -- row-level security is inert otherwise, see
# db/migrations/003_app_role.sql. Only migrations use the admin URL.
DATABASE_URL=postgres://warrant_app:warrant_app@localhost:5433/warrant
DATABASE_ADMIN_URL=postgres://warrant:warrant@localhost:5433/warrant

PORT=3001
LOG_LEVEL=info

# Ed25519 keypair used to sign agent capabilities.
# Generate a development pair with:  npm run keys:generate
# These are PEM blocks with newlines escaped as \n.
CAPABILITY_PRIVATE_KEY=
CAPABILITY_PUBLIC_KEY=

# Model provider for the agent runtime.
#   fixture  - replay recorded model outputs; deterministic, no API key, used by CI
#   anthropic - live calls
MODEL_PROVIDER=fixture
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Deterministic seed for the simulated processors' fault injection.
SIMULATOR_SEED=warrant-dev
